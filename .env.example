MILVUS_ADDRESS=localhost:19530
MILVUS_COLLECTION=ai_learning_knowledge
# Set these only if Milvus authentication is enabled.
MILVUS_USERNAME=
MILVUS_PASSWORD=

RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
